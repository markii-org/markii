{
  "name": "@markii/host",
  "version": "0.1.0",
  "description": "Shared, host-neutral script-running layer for Markii hosts: tier gating, the grant model, address pinning, and the terminatable-isolate watchdog, plus the HostAdapter contract and createMarkiiHost. Entries: the neutral main entry, /node, /browser, /conformance.",
  "license": "MIT",
  "author": "sadigaxund",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./conformance": {
      "types": "./dist/conformance.d.ts",
      "import": "./dist/conformance.js",
      "default": "./dist/conformance.js"
    }
  },
  "scripts": {
    "pretest": "npm run generate:doc-css --workspace @markii/html",
    "test": "vitest run",
    "prebuild": "npm run generate:doc-css --workspace @markii/html",
    "build": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "build:dist": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/build-dist-assets.mjs"
  },
  "dependencies": {
    "@markii/bundle": "^0.17.0-next.1",
    "@markii/core": "^0.17.0-next.1",
    "@markii/lua": "^0.17.0-next.1",
    "@markii/pack": "^0.17.0-next.1",
    "@markii/runtime": "^0.17.0-next.1",
    "@markii/stdlib": "^0.17.0-next.1",
    "fflate": "^0.8.3"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@markii/html": "^0.17.0-next.1",
    "@markii/react": "^0.17.0-next.1"
  },
  "peerDependenciesMeta": {
    "@markii/html": {
      "optional": true
    },
    "@markii/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@markii/html": "^0.17.0-next.1",
    "@markii/react": "^0.17.0-next.1",
    "esbuild": "^0.28.2"
  }
}
