{
  "name": "@markii/host",
  "version": "0.1.0",
  "description": "Shared, host-neutral script-running layer for Markii hosts (apps/vscode, and any future host): tier gating, the grant model, DNS/address pinning, and the terminatable-isolate watchdog around the worker_thread Run path. PRIVATE — never published, exists only to be shared between apps in this repo.",
  "license": "MIT",
  "author": "sadigaxund",
  "private": true,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./node": {
      "types": "./src/node.ts",
      "import": "./src/node.ts",
      "default": "./src/node.ts"
    }
  },
  "scripts": {
    "pretest": "npm run generate:doc-css --workspace @markii/html",
    "test": "vitest run",
    "prebuild": "npm run generate:doc-css --workspace @markii/html",
    "build": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "@markii/bundle": "*",
    "@markii/core": "*",
    "@markii/html": "*",
    "@markii/lua": "*",
    "@markii/pack": "*",
    "@markii/react": "*",
    "@markii/runtime": "*",
    "@markii/stdlib": "*",
    "fflate": "^0.8.3"
  }
}
