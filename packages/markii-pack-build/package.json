{
  "name": "@markii/pack-build",
  "version": "0.17.0-next.3",
  "description": "Pack compilation for Markii authoring hosts: compiles a pack's component sources (and imported CSS) with esbuild-wasm's in-process path, and writes the prebuilt form or a .mkp archive. Node only.",
  "keywords": [
    "markdown",
    "mk.md",
    "markii",
    "pack",
    "esbuild"
  ],
  "license": "MIT",
  "author": "sadigaxund",
  "homepage": "https://github.com/markii-org/markii#readme",
  "bugs": "https://github.com/markii-org/markii/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markii-org/markii.git",
    "directory": "packages/markii-pack-build"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "build:dist": "rm -rf dist && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@markii/host": "^0.17.0-next.3",
    "@markii/pack": "^0.17.0-next.3",
    "esbuild-wasm": "^0.28.2",
    "fflate": "^0.8.3"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
