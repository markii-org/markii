{
  "name": "@markii/pack-build",
  "version": "0.17.0-next.1",
  "description": "Pack compilation for Markii authoring hosts: compiles a pack's component sources (and imported CSS) with esbuild-wasm's in-process path, and writes the prebuilt form or a .mkp archive. Node only.",
  "license": "MIT",
  "author": "sadigaxund",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "build:dist": "rm -rf dist && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@markii/host": "^0.1.0",
    "@markii/pack": "^0.17.0-next.1",
    "esbuild-wasm": "^0.28.2",
    "fflate": "^0.8.3"
  },
  "files": [
    "dist"
  ]
}
