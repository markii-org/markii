{
  "name": "@markii/ansi",
  "version": "0.17.0-next.1",
  "description": "The terminal renderer for Markii (.mk.md): a registry-driven hast-to-terminal engine built on Ink. Renders a note once as a string with optional color, for a pipe or a log, or as a live Ink tree a host can mount.",
  "keywords": [
    "markdown",
    "markii",
    "mk.md",
    "ansi",
    "terminal",
    "renderer",
    "cli",
    "directive"
  ],
  "license": "MIT",
  "author": "sadigaxund",
  "homepage": "https://github.com/markii-org/markii#readme",
  "bugs": "https://github.com/markii-org/markii/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markii-org/markii.git",
    "directory": "packages/platforms/markii-ansi"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js",
      "default": "./dist/components/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc --noEmit -p tsconfig.json",
    "build:dist": "rm -rf dist && tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "regenerate:fixtures": "npm run build:dist && node scripts/regenerate-ansi-fixtures.ts"
  },
  "dependencies": {
    "@markii/core": "^0.17.0-next.1",
    "@markii/pack": "^0.17.0-next.1",
    "@markii/stdlib": "^0.17.0-next.1",
    "ink": "^7.1.1",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "@markii/runtime": "^0.17.0-next.1",
    "@types/react": "^19.2.0"
  }
}
