{
  "name": "@markii/html",
  "version": "0.9.0",
  "description": "A framework-free static HTML renderer for Markii (.mk.md): a registry-driven hast-to-HTML string engine. Zero React; for stopped-changing documents (publish, CI, email, archive).",
  "keywords": [
    "markdown",
    "markii",
    "mk.md",
    "html",
    "renderer",
    "static",
    "directive"
  ],
  "license": "MIT",
  "author": "sadigaxund",
  "homepage": "https://github.com/markii-org/markii#readme",
  "bugs": "https://github.com/markii-org/markii/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markii-org/markii.git",
    "directory": "packages/platforms/markii-html"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js",
      "default": "./dist/components/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate:doc-css": "node scripts/generate-doc-css.ts",
    "pretest": "npm run generate:doc-css",
    "test": "vitest run",
    "prebuild": "npm run generate:doc-css",
    "build": "tsc --noEmit -p tsconfig.json",
    "prebuild:dist": "npm run generate:doc-css",
    "build:dist": "rm -rf dist && tsc -p tsconfig.build.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "hast-util-to-html": "^9.0.0",
    "@markii/core": "0.9.0",
    "@markii/runtime": "0.9.0",
    "@markii/stdlib": "0.9.0"
  },
  "devDependencies": {
    "@types/hast": "^3.0.4"
  }
}
