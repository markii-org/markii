{
  "name": "@markii/cli",
  "version": "0.17.0-next.3",
  "description": "A terminal front end for Markii (.mk.md): view, export, and run a note's scripts from the command line.",
  "keywords": [
    "markdown",
    "markii",
    "mk.md",
    "cli",
    "terminal"
  ],
  "private": false,
  "license": "MIT",
  "author": "sadigaxund",
  "homepage": "https://github.com/markii-org/markii/tree/main/apps/cli#readme",
  "bugs": "https://github.com/markii-org/markii/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markii-org/markii.git",
    "directory": "apps/cli"
  },
  "bin": {
    "markii": "dist/markii.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && node esbuild.config.mjs --production",
    "build:dist": "npm run build",
    "prepack": "npm run build",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@markii/ansi": "*",
    "@markii/bundle": "*",
    "@markii/core": "*",
    "@markii/host": "*",
    "@markii/lua": "*",
    "@markii/pack-build": "*",
    "@markii/runtime": "*",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12",
    "ink": "^7.1.1",
    "react": "^19.2.0",
    "@types/react": "^19.2.0"
  }
}
